{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git init)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(./gradlew *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(docker compose *)",
      "Bash(./infra/scripts/*)",
      "Bash(helm *)",
      "Bash(git push origin main)",
      "Bash(git push -u origin main)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)"
    ]
  }
}
