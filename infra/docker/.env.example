# Settings for the local stack (docker compose) and ./gradlew :app:bootRun.
# infra/scripts/dev-up.sh copies this file to .env on the first run; .env is never committed.

POSTGRES_DB=ultimate
POSTGRES_USER=ultimate
POSTGRES_PASSWORD=local-dev-only

# Host ports, published on 127.0.0.1 only
POSTGRES_PORT=5432
APP_PORT=8080

# Optional satellite base map: XYZ raster tiles with {z}/{x}/{y}, usually with your own provider key, which stays in
# .env. Check the provider's terms; see README.md, "Base maps". Empty: map view only.
APP_MAP_SATELLITE_TILES_URL=
APP_MAP_SATELLITE_ATTRIBUTION=
APP_MAP_SATELLITE_TILE_SIZE=256
